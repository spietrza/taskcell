{
  "expo": {
    "name": "Taskcell",
    "slug": "taskcell-mobile",
    "scheme": "taskcell",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.taskcell.mobile",
      "infoPlist": { "NSFaceIDUsageDescription": "Confirm merging a pull request." }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-local-authentication", "expo-notifications"],
    "experiments": { "typedRoutes": true }
  }
}
