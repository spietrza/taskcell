{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "taskcell-desktop",
  "version": "0.1.0",
  "identifier": "dev.vanguard.desktop",
  "build": {
    "beforeDevCommand": "pnpm build",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [{ "title": "Taskcell", "width": 1100, "height": 800, "minWidth": 1000, "minHeight": 600, "titleBarStyle": "Overlay", "hiddenTitle": true }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
