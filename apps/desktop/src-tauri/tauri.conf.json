{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taskcell",
  "version": "1.16.0",
  "identifier": "dev.vanguard.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Taskcell", "width": 1100, "height": 800, "minWidth": 1000, "minHeight": 600, "titleBarStyle": "Overlay", "hiddenTitle": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_CONTENTS_OF_UPDATER_KEY.PUB",
      "endpoints": ["https://github.com/spietrza/taskcell/releases/download/desktop-latest/latest.json"]
    }
  }
}
