{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taskcell Desktop",
  "version": "1.16.0",
  "identifier": "dev.vanguard.desktop",
  "build": {
    "beforeDevCommand": "pnpm build",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [{ "create": false, "title": "Taskcell Desktop", "width": 1100, "height": 800, "minWidth": 1000, "minHeight": 600, "titleBarStyle": "Overlay", "hiddenTitle": true }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDRDlERTIwMTMzNTVEODEKUldTQlhUVVRJTjdaRERPN2g1SGppRkQxMVhLYW5xUnkrd2xaUFhqa1ZWTFpmbkk4U29PZVZoOEgK",
      "endpoints": ["https://github.com/spietrza/taskcell/releases/download/desktop-latest/latest.json"]
    }
  }
}
