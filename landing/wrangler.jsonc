{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  // taskcell.dev: the static site in dist/ (node build.mjs) behind a small Worker (see worker.js).
  // Deployed by hand, never from CI: pnpm build && pnpm dlx wrangler@4 deploy
  "name": "taskcell-landing",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker has to see www requests before the asset server answers them.
    "run_worker_first": true
  },
  // Orders recorded by the Stripe webhook (stripe-webhook.js); the table is in orders.sql.
  "d1_databases": [
    { "binding": "ORDERS", "database_name": "taskcell-orders", "database_id": "fdbd3b23-7b4a-4234-b84c-025d3a26eb88" }
  ],
  // Who gets a Stripe checkout (checkout.js): "test" = only links carrying test=1, against the sandbox.
  // Hosting is not open: do not set "live" before servers can be provisioned and the page copy says it is open.
  "vars": { "CHECKOUT": "test" },
  "routes": [
    { "pattern": "taskcell.dev", "custom_domain": true },
    { "pattern": "www.taskcell.dev", "custom_domain": true }
  ]
}
