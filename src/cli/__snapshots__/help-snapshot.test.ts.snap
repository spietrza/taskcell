exports[`--help output > eval help is unchanged 1`] = `
"taskcell eval [options]

  Run the committed eval corpus and print a per-kind pass-rate report.

  Options:
    --repo <path>           Repo checkout to work in (default: cwd)
    --json                  Machine-readable JSON output
    --limit <n>             Maximum number of entries
    --out <file>            Write the result to this local file instead of posting it
    --github-repo <o/r>     GitHub repo slug (owner/repo)
    --since <date>          Only entries at or after this date or window
    --branch <name>         Metrics branch to read or write (default: taskcell-metrics)
    --judge-model <m>       Model for the judge (default: a Haiku model, or a decision model)
    --produce-model <m>     Model under test (default: claude-sonnet-5-5)
    --suggest               Draft eval-corpus candidates from retrospective memory instead of running the corpus
    --markdown              With --suggest: force markdown output
    --baseline <file|main>  Gate against a saved baseline: a local file, or "main" for the latest on the metrics branch
    --max-drop <points>     Max tolerated drop in overall pass rate, in points (default 5; with --baseline)
    --allow-corpus-change   Compare against a baseline whose corpus hash differs, instead of refusing
    --save-baseline         Publish this result as the new baseline
    --help                  Print help for this command"
`;

exports[`--help output > gc help is unchanged 1`] = `
"taskcell gc [options]

  Reap stale sandbox containers, prune worktrees, and (with --remote) delete merged remote chore/taskcell-* branches.

  Options:
    --repo <path>          Repo checkout to work in (default: cwd)
    --dry-run              Report what would happen without changing anything
    --max-age-hours <n>    Only reap resources older than n hours (default: 6)
    --remote <owner/repo>  Also delete merged remote chore/taskcell-* (or chore/vanguard-*) branches (needs gh)
    --abandoned            Also delete branches whose PR is closed-unmerged
    --help                 Print help for this command"
`;

exports[`--help output > history help is unchanged 1`] = `
"taskcell history <owner/repo#N> [options]

  One issue's history over the audit streams (trigger, runs, reviews, approver, merge).

  Options:
    --repo <path>       Repo checkout to work in (default: cwd)
    --config-dir <dir>  The hub config dir holding the hub audit log (default: the hub's own)
    --branch <name>     Metrics branch to read or write (default: taskcell-metrics)
    --json              Machine-readable JSON output
    --offline           Do not ask the Git host (no label/comment/merge events)
    --help              Print help for this command"
`;

exports[`--help output > hub help is unchanged 1`] = `
"taskcell hub [rotate-token] [options]

  Serve the Inspector UI over HTTP/SSE; "hub rotate-token --token-file <path>" writes a new token.

  Options:
    --repo <path>                 Repo checkout to work in (default: cwd)
    --host <addr>                 Address to bind (env TASKCELL_HUB_HOST; default: 127.0.0.1)
    --port <port>                 Port to bind, 1-65535 (env TASKCELL_HUB_PORT; default: 7777)
    --ui-dir <dir>                Serve the Inspector UI from this directory instead of the bundled one
    --no-open                     Do not open the browser
    --demo                        Open a read-only demo project on bundled sample data (touches no repo, remote or hub store)
    --token-file <path>           Keep one token across restarts (env TASKCELL_HUB_TOKEN_FILE; created 0600 if missing)
    --allowed-host <host>         Extra Host header accepted on a non-loopback bind (repeatable)
    --admin-github-login <login>  GitHub login granted admin access (repeatable)
    --help                        Print help for this command"
`;

exports[`--help output > lessons help is unchanged 1`] = `
"taskcell lessons record|list|dismiss <id> [options]

  record: distil 0-3 lessons from a closed factory PR or MR; list | dismiss <id>: show or dismiss live lessons.

  Options:
    --repo <path>             Repo checkout to work in (default: cwd)
    --branch <name>           Metrics branch to read or write (default: taskcell-metrics)
    --json                    Machine-readable JSON output
    --github-repo <o/r>       GitHub repo slug (owner/repo)
    --gitlab-project <g/p>    GitLab project path (group/project)
    --pr <n>                  PR number
    --dry-run                 Report what would happen without changing anything
    --provider-model <m>      Model for the implementer/simplifier stages (default: provider's default), or a weighted pool: claude/sonnet:3,codex/gpt-6-sol:1
    --feedback-authors <a,b>  Logins trusted beyond OWNER/MEMBER/COLLABORATOR
    --mr <n>                  (record) GitLab MR number, with --gitlab-project
    --help                    Print help for this command"
`;

