// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`--help output > approve help is unchanged 1`] = `
"taskcell approve [PR number] [options]

  Compute a deterministic APPROVE/ESCALATE decision for a factory PR; shadow mode (default) never merges.

  Options:
    --repo <path>                Repo checkout to work in (default: cwd)
    --github-repo <o/r>          Repo slug — the approver never infers the repo it judges
    --branch <name>              Metrics branch to read or write (default: taskcell-metrics)
    --json                       Machine-readable JSON output
    --dry-run                    Report what would happen without changing anything
    --pr <n>                     PR number (bare positional also accepted)
    --mode <shadow|enforce|act>  shadow (default) only records and comments, check neutral; enforce: check success/failure, never merges; act merges (see docs/autonomous-loop.md)
    --rerun-open                 Re-judge every open factory PR (instead of --pr); decisions are appended only where the policy hash changed
    --review-run-id <id>         Removed: act mode reads the run stamp on the review itself; passing it is an error
    --help                       Print help for this command"
`;

exports[`--help output > audit help is unchanged 1`] = `
"taskcell audit verify|export [options]

  verify | export the hash-chained audit streams (hub, run-events, metrics, decisions, lessons); see docs/audit.md.

  Options:
    --repo <path>         Repo checkout to work in (default: cwd)
    --since <date>        Only entries at or after this date or window
    --branch <name>       Metrics branch to read or write (default: taskcell-metrics)
    --config-dir <dir>    The hub config dir holding the hub audit log (default: the hub's own)
    --stream <name>       One of hub, run-events, metrics, decisions, lessons (default: all)
    --until <date>        (export) Only entries up to this date
    --format <jsonl|csv>  (export) Output format (default: jsonl)
    --help                Print help for this command"
`;

exports[`--help output > doctor help is unchanged 1`] = `
"taskcell doctor [options]

  Check whether watch can run AFK before any issue is claimed; takes the same flags as watch.

  Options:
    --provider <claude|codex|cursor|zai|openrouter|meridian>         Provider that runs every stage (default: claude)
    --review-provider <claude|codex|cursor|zai|openrouter|meridian>  Run only the review stage on this provider (cross-provider review)
    --fallback-provider <name>                                       Retry on this provider when the primary one fails (outage, limit, revoked credential); a comma list (codex,cursor) is a fallback chain
    --fallback-model <model>                                         Model for every stage that fell back (default: that provider's default); a comma list pairs with --fallback-provider
    --usage-cap <pct>                                                Stop starting work once the provider's plan window is at/over this % (1-100; env TASKCELL_USAGE_CAP_PCT)
    --provider-model <m>                                             Model for the implementer/simplifier stages (default: provider's default), or a weighted pool: claude/sonnet:3,codex/gpt-6-sol:1
    --review-model <m>                                               Model for the review stage (default: provider's default), or a pool as for --provider-model
    --escalate-model <m>                                             Model for the 2nd and later gate repairs (default: stay on the implementer model)
    --no-simplify                                                    Skip the simplifier stage (lean: implement -> review only)
    --verify <cmd>                                                   Verification command for Proof of Work (overrides TASKCELL_VERIFY_CMD and auto-detect)
    --visual-proof <cmd>                                             Visual proof command for UI artifacts (overrides TASKCELL_VISUAL_PROOF_CMD)
    --conformance                                                    Run the conformance pass (planner-tier model checks the diff against the spec; opt-in)
    --conformance-model <m>                                          Model for the conformance stage (default: same as implementer)
    --commit-author <a>                                              Git author "Name <email>"; also enables white-label mode (no Taskcell branding)
    --plan                                                           Add a dedicated planning stage first (opus, high effort); same as --flow plan
    --flow <name>                                                    Run a named workflow (e.g. flow-b: plan -> implement -> adversary -> repair)
    --base <branch>                                                  Base branch to branch off and target the PR at (default: main)
    --max-turns <n>                                                  Override the agent turn cap
    --max-repair-iterations <n>                                      Override the conformance/verify repair loop-back cap (default: 2)
    --skills <dir>                                                   Skills directory, merged with the repo's .github/vanguard-skills/
    --pnpm-store                                                     Mount a persistent pnpm store, one per repo (see docs/cli.md)
    --feedback-authors <a,b>                                         Logins trusted beyond OWNER/MEMBER/COLLABORATOR
    --spec-model <m>                                                 Model for the tech-spec stage
    --repo <path>                                                    Repo checkout to work in (default: cwd)
    --github-repo <o/r>                                              GitHub repo slug (owner/repo)
    --gitlab-project <g/p>                                           GitLab project path (group/project)
    --label <name>                                                   Trigger label
    --trigger-state <x>                                              Status option name for ready items (project default "Todo"; linear: state type, default "unstarted")
    --trigger-state-name <x>                                         Linear display state name matching --trigger-state
    --claimed-state <x>                                              Status/label set on claim (github: label taskcell:running)
    --review-state <x>                                               Status/label set after a PR opens (github: label taskcell:needs-human-review)
    --spec-claimed-label <l>                                         (loop-v1, github/gitlab) Label set while an issue is being specced
    --dependency-repos <o/r,o/r>                                     Other repos a \`Depends on\` reference may be read from (default: only the watched repo)
    --concurrency <n>                                                Max items processed at once (default: 2)
    --interval <seconds>                                             Poll interval (default: 60)
    --once                                                           Do a single pass
    --egress                                                         Run the sandbox with allow-listed network egress
    --llm-proxy                                                      Hold model credentials in a host sidecar instead of the sandbox
    --source <linear|github|project|gitlab>                          Task source (default: linear; github when --github-repo is given)
    --project <number>                                               (--source project) GitHub Projects v2 project number
    --team <KEY>                                                     (linear) limit to a team
    --max-tasks <n>                                                  Cap the ready tasks claimed per poll, for each phase (default: unlimited)
    --issue <ref>                                                    (--source github) Run only this issue (owner/repo#n or a bare number); implies --once
    --loop-v1                                                        Use Loop v1 defaults (routing labels / states for the spec and agent passes)
    --spec-label <l>                                                 (loop-v1, github/gitlab) Label that triggers the spec pass
    --agent-label <l>                                                (loop-v1, github/gitlab) Label that triggers the agent pass
    --needs-info-label <l>                                           (loop-v1, github/gitlab) Label set when the spec needs information
    --spec-state <x>                                                 (loop-v1, linear) State type that triggers the spec pass
    --spec-state-name <x>                                            (loop-v1, linear) State name the spec pass reverts to
    --agent-state <x>                                                (loop-v1, linear) State the spec pass advances specced issues into
    --needs-info-state <x>                                           (loop-v1, linear) State set when the spec needs information
    --spec-claimed-state <x>                                         (loop-v1, linear) State set while an issue is being specced
    --spec-only                                                      Run only the spec pass (needs loop-v1 and a review --agent-label/--agent-state other than the build trigger)
    --fix                                                            Install the repo-pinned agent CLIs in the sandbox image if it is stale, then re-check
    --help                                                           Print help for this command"
`;

