"taskcell watch-mrs [options]

  Poll GitLab MRs by label and run the non-blocking review loop.

  Options:
    --repo <path>                                             Repo checkout to work in (default: cwd)
    --provider <claude|codex|cursor|zai|openrouter|meridian>  Provider that runs every stage (default: claude)
    --review-model <m>                                        Model for the review stage (default: provider's default), or a pool as for --provider-model
    --max-turns <n>                                           Override the agent turn cap
    --usage-cap <pct>                                         Stop starting work once the provider's plan window is at/over this % (1-100; env TASKCELL_USAGE_CAP_PCT)
    --egress                                                  Run the sandbox with allow-listed network egress
    --llm-proxy                                               Hold model credentials in a host sidecar instead of the sandbox
    --skills <dir>                                            Skills directory, merged with the repo's .github/vanguard-skills/
    --gitlab-project <g/p>                                    GitLab project path (group/project)
    --label <name>                                            Trigger label
    --reviewing-label <l>                                     Label added while an item is being reviewed
    --reviewed-label <l>                                      Label added after review succeeds
    --author <login>                                          Only review items opened by this author
    --concurrency <n>                                         Max items processed at once (default: 2)
    --interval <seconds>                                      Poll interval (default: 60)
    --once                                                    Do a single pass
    --help                                                    Print help for this command"
`;

exports[`--help output > watch-prs help is unchanged 1`] = `
"taskcell watch-prs [options]

  Poll GitHub PRs by label and run the non-blocking review loop.

  Options:
    --repo <path>                                             Repo checkout to work in (default: cwd)
    --provider <claude|codex|cursor|zai|openrouter|meridian>  Provider that runs every stage (default: claude)
    --review-model <m>                                        Model for the review stage (default: provider's default), or a pool as for --provider-model
    --max-turns <n>                                           Override the agent turn cap
    --usage-cap <pct>                                         Stop starting work once the provider's plan window is at/over this % (1-100; env TASKCELL_USAGE_CAP_PCT)
    --egress                                                  Run the sandbox with allow-listed network egress
    --llm-proxy                                               Hold model credentials in a host sidecar instead of the sandbox
    --skills <dir>                                            Skills directory, merged with the repo's .github/vanguard-skills/
    --github-repo <o/r>                                       GitHub repo slug (owner/repo)
    --label <name>                                            Required trigger label (e.g. "ready for taskcell review")
    --reviewing-label <l>                                     Label added while an item is being reviewed
    --reviewed-label <l>                                      Label added after review succeeds
    --author <login>                                          Only review items opened by this author
    --concurrency <n>                                         Max items processed at once (default: 2)
    --interval <seconds>                                      Poll interval (default: 60)
    --once                                                    Do a single pass
    --feedback-authors <a,b>                                  Logins trusted beyond OWNER/MEMBER/COLLABORATOR
    --pr <n>                                                  Also review this PR even if the label scan misses it
    --pinned-only                                             With a pinned PR, review only it and skip the label scan (per-PR CI concurrency group, one run per labelled PR)
    --help                                                    Print help for this command"
`;
