    --gitlab-project <g/p>                                    GitLab project path (group/project)
    --label <name>                                            Trigger label
    --reviewing-label <l>                                     Label added while an item is being reviewed
    --reviewed-label <l>                                      Label added after review succeeds
    --author <login>                                          Only review items opened by this author
    --provider <claude|codex|cursor|zai|openrouter|meridian>  Provider that runs every stage (default: claude)
    --review-model <m>                                        Model for the review stage (default: provider's default), or a pool as for --provider-model
    --llm-proxy                                               Hold model credentials in a host sidecar instead of the sandbox
    --help                                                    Print help for this command"
`;

